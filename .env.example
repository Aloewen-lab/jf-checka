# Kopie dieser Datei als .env anlegen und Werte eintragen.
# .env ist gitignoriert und darf NIE committet werden.

SERPAPI_KEY=

# Gmail-App-Passwort (nicht das normale Google-Passwort!).
# Erzeugen unter https://myaccount.google.com/apppasswords  (setzt 2FA voraus)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=person.a@example.com
SMTP_PASS=
